    "FLAIROS_DEVICE_TV",
    "FLAIROS_DISPLAY_LANDSCAPE",
    "FLAIROS_DISPLAY_4K",
    "FLAIROS_4K_UHD",
    "PRESET_TARGET_HZ=90"
  ]
}
