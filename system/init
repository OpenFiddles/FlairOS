#!/bin/sh
mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
mkdir -p /run /tmp /opt/flairos/apps /var/lib/airp/packages
chmod 1777 /tmp
export HOME=/root
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
echo
echo "FlairOS V2"
echo "Linux foundation initialized."
echo "FlairOS userspace ready"
echo "AirP (AirPacket) is available: airp help"
echo
exec /bin/sh
