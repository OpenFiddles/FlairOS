set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR i386)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

if(CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "^(i[3-6]86|x86_64|AMD64|amd64)$")
    find_program(FLAIROS_CC gcc REQUIRED)
    find_program(FLAIROS_LD ld REQUIRED)
    find_program(FLAIROS_OBJCOPY objcopy REQUIRED)
    set(FLAIROS_TARGET_FLAGS "")
    set(FLAIROS_TOOLCHAIN_CFLAGS "-fno-tree-loop-distribute-patterns")
else()
    find_program(FLAIROS_CC clang REQUIRED)
    find_program(FLAIROS_LD ld.lld REQUIRED)
    find_program(FLAIROS_OBJCOPY llvm-objcopy REQUIRED)
    set(FLAIROS_TARGET_FLAGS "--target=i386-none-elf")
    set(FLAIROS_TOOLCHAIN_CFLAGS "")
endif()

set(CMAKE_C_COMPILER "${FLAIROS_CC}" CACHE FILEPATH "" FORCE)
if(FLAIROS_TARGET_FLAGS)
    set(CMAKE_C_COMPILER_TARGET "i386-none-elf" CACHE STRING "" FORCE)
endif()
